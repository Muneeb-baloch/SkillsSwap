rules_version = '2';

// Source of truth for Firestore Security Rules. Firestore does NOT read
// this file automatically — after editing, paste the contents into
// Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admin account for monitoring swap agreements. Replace with the real
    // admin UID: Firebase Console → Authentication → Users → copy UID.
    function isAdmin() {
      return request.auth.uid == 'ADMIN_UID_HERE';
    }

    // User profiles: any signed-in user can view them (browsing listings,
    // viewing profiles). Only the owner writes their own doc, EXCEPT
    // rating + reviewCount, which are recalculated from the reviewer's
    // device after a swap (LeaveReviewScreen).
    match /users/{uid} {
      allow read: if signedIn();
      allow create, delete: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (
        request.auth.uid == uid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['rating', 'reviewCount'])
      );
    }

    // Signup OTP codes: strictly private to the account being verified.
    match /emailVerifications/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Listings: browsable by all signed-in users. Owner-only writes,
    // except any signed-in user may bump the views/requests counters
    // (ListingDetailScreen increments them on other people's listings).
    match /listings/{listingId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['views', 'requests'])
      );
    }

    // Barter requests: only the two people involved can see or update
    // them (status flow: pending → accepted/declined →
    // completion_requested → completed/disputed).
    match /barterRequests/{requestId} {
      allow read, update: if signedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow create: if signedIn() && request.resource.data.fromUserId == request.auth.uid;
    }

    // Chats: participants only. Updates cover lastMessage/lastMessageAt.
    match /chats/{chatId} {
      allow read, update: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        // Participants write their own messages; 'system' messages (swap
        // status updates, agreement notices) are also posted from a
        // participant's device, so they're allowed for participants too.
        allow create: if signedIn() &&
          (request.resource.data.senderId == request.auth.uid ||
            request.resource.data.senderId == 'system') &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // Swap agreements: readable/updatable only by the two parties (and the
    // admin, who sees everything for monitoring). Created from the accepting
    // user's device when a request is accepted — the creator must be one of
    // the parties named in the agreement itself.
    match /swapAgreements/{agreementId} {
      allow read: if signedIn() && (
        resource.data.party1.userId == request.auth.uid ||
        resource.data.party2.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if signedIn() && (
        request.resource.data.party1.userId == request.auth.uid ||
        request.resource.data.party2.userId == request.auth.uid
      );
      allow update: if signedIn() && (
        resource.data.party1.userId == request.auth.uid ||
        resource.data.party2.userId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Shared counters (swap agreement reference numbers). Incremented in a
    // transaction from the client, so any signed-in user may read/write.
    match /counters/{counterId} {
      allow read, write: if signedIn();
    }

    // Reviews: readable by all signed-in users; written once by the
    // reviewer; never edited or deleted from the client.
    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.fromUserId == request.auth.uid;
    }
  }
}
